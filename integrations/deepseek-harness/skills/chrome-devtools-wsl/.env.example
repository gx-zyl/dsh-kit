# Chrome DevTools WSL — configuration file
# Loaded automatically when just starts; also the source of environment variables for the Python scripts
#
# After editing, just re-run just start / just serve for it to take effect

# Windows working directory: where chrome_debug.py is deployed + where the Chrome profile lives
CCW_DIR=D:\chrome-devtools-wsl

# Windows Python path (leave empty to auto-detect through PowerShell: Get-Command python.exe)
# If auto-detection fails, fill in the full path manually, for example:
# PYWIN=C:\Users\you\AppData\Local\Programs\Python\Python313\python.exe
PYWIN=

# Chrome CDP debugging port
CDP_PORT=9222
